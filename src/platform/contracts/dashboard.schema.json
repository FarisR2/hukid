{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hukid.example.invalid/schemas/dashboard-v0.1",
  "title": "DASH-T03 laboratory transport",
  "$ref": "#/$defs/Overview",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "Cursor": {
      "type": "string",
      "minLength": 32,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "timeZone": {
          "const": "UTC"
        },
        "bounds": {
          "const": "[from,to)"
        }
      },
      "required": [
        "from",
        "to",
        "timeZone",
        "bounds"
      ]
    },
    "Section": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "available"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "asOf": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            },
            "reasonCode": {
              "type": "null"
            }
          },
          "required": [
            "state",
            "value",
            "asOf",
            "reasonCode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "stale"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "asOf": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            },
            "reasonCode": {
              "const": "source_stale"
            }
          },
          "required": [
            "state",
            "value",
            "asOf",
            "reasonCode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "value": {
              "type": "null"
            },
            "asOf": {
              "type": "null"
            },
            "reasonCode": {
              "enum": [
                "source_not_connected",
                "scope_not_applicable"
              ]
            }
          },
          "required": [
            "state",
            "value",
            "asOf",
            "reasonCode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "error"
            },
            "value": {
              "type": "null"
            },
            "asOf": {
              "type": "null"
            },
            "reasonCode": {
              "const": "source_failed"
            }
          },
          "required": [
            "state",
            "value",
            "asOf",
            "reasonCode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "notAuthorized"
            },
            "value": {
              "type": "null"
            },
            "asOf": {
              "type": "null"
            },
            "reasonCode": {
              "const": "capability_required"
            }
          },
          "required": [
            "state",
            "value",
            "asOf",
            "reasonCode"
          ]
        }
      ]
    },
    "Overview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "issuerId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "activeMembers": {
              "$ref": "#/$defs/Section"
            },
            "activeIssuers": {
              "$ref": "#/$defs/Section"
            },
            "publishedDefinitionVersions": {
              "$ref": "#/$defs/Section"
            },
            "createdRequests": {
              "$ref": "#/$defs/Section"
            },
            "issuedCredentials": {
              "$ref": "#/$defs/Section"
            },
            "pendingStatusChanges": {
              "$ref": "#/$defs/Section"
            }
          },
          "required": [
            "activeMembers",
            "activeIssuers",
            "publishedDefinitionVersions",
            "createdRequests",
            "issuedCredentials",
            "pendingStatusChanges"
          ]
        }
      },
      "required": [
        "tenantId",
        "issuerId",
        "generatedAt",
        "window",
        "sections"
      ]
    },
    "ActivityEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "action": {
          "enum": [
            "auth.step_up.completed",
            "auth.context.changed",
            "auth.refresh.completed",
            "auth.logout.completed",
            "auth.family.revoked",
            "members.invitation.created",
            "members.invitation.revoked",
            "members.invitation.accepted",
            "members.invitation.expired",
            "members.delivery.sent",
            "members.delivery.failed",
            "members.membership.changed",
            "members.membership.revoked",
            "members.membership.reentered",
            "members.retention.purged"
          ]
        },
        "outcome": {
          "const": "success"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "actorId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "eventId",
        "action",
        "outcome",
        "occurredAt",
        "actorId",
        "targetId"
      ]
    },
    "Activity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "issuerId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "asOf": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ActivityEvent"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 32,
              "maxLength": 2048,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tenantId",
        "issuerId",
        "generatedAt",
        "window",
        "asOf",
        "items",
        "nextCursor"
      ]
    },
    "Problem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "about:blank"
            },
            "title": {
              "const": "invalid_request"
            },
            "status": {
              "const": 400
            },
            "code": {
              "const": "invalid_request"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code",
            "correlationId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "about:blank"
            },
            "title": {
              "const": "invalid_credential"
            },
            "status": {
              "const": 401
            },
            "code": {
              "const": "invalid_credential"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code",
            "correlationId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "about:blank"
            },
            "title": {
              "const": "forbidden"
            },
            "status": {
              "const": 403
            },
            "code": {
              "const": "forbidden"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code",
            "correlationId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "about:blank"
            },
            "title": {
              "const": "resource_not_found"
            },
            "status": {
              "const": 404
            },
            "code": {
              "const": "resource_not_found"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code",
            "correlationId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "about:blank"
            },
            "title": {
              "const": "invalid_input"
            },
            "status": {
              "const": 422
            },
            "code": {
              "const": "invalid_input"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code",
            "correlationId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "about:blank"
            },
            "title": {
              "const": "invalid_cursor"
            },
            "status": {
              "const": 422
            },
            "code": {
              "const": "invalid_cursor"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code",
            "correlationId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "about:blank"
            },
            "title": {
              "const": "rate_limited"
            },
            "status": {
              "const": 429
            },
            "code": {
              "const": "rate_limited"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code",
            "correlationId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "about:blank"
            },
            "title": {
              "const": "dependency_unavailable"
            },
            "status": {
              "const": 503
            },
            "code": {
              "const": "dependency_unavailable"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code",
            "correlationId"
          ]
        }
      ]
    }
  }
}
