  "components": {
    "securitySchemes": {
      "operatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "integrationBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "oid4vciBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "headers": {
      "NoStore": {
        "required": true,
        "schema": {
          "type": "string",
          "enum": ["no-store"]
        }
      },
      "ETag": {
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "TenantID": {
        "name": "tenantId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "IssuerID": {
        "name": "issuerId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "KeyID": {
        "name": "kid",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "ClientID": {
        "name": "clientId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "IssuerSlug": {
        "name": "slug",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "OfferRef": {
        "name": "ref",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "StatusPurpose": {
        "name": "purpose",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "enum": ["revocation", "suspension"] }
      },
      "ListID": {
        "name": "listId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "DefinitionID": {
        "name": "definitionId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "DefinitionVersion": {
        "name": "version",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "DefinitionVersionArtifact": {
        "name": "version",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "RequestID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "CredentialHandleID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
      },
      "AuditActionQuery": {
        "name": "action",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "maxLength": 128 }
      }
    },
    "responses": {
      "OAuthError400": {
        "description": "OAuth / OID4VCI protocol error",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthError" } } }
      },
      "OAuthError401": {
        "description": "Unauthorized bearer or client credentials",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthError" } } }
      },
      "OAuthError404": {
        "description": "Public resource not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthError" } } }
      },
      "Problem401": {
        "description": "Unauthorized",
        "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Problem403": {
        "description": "Forbidden or step-up MFA required",
        "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Problem404": {
        "description": "Resource not found in tenant",
        "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Problem409": {
        "description": "Conflict or immutable state transition",
        "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Problem412": {
        "description": "ETag mismatch",
        "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Problem422": {
        "description": "Validation failed",
        "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Problem428": {
        "description": "If-Match precondition header required",
        "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Problem503": {
        "description": "Signing/KMS or dependency unavailable",
        "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "GenericJSON": {
        "type": "object",
        "additionalProperties": true
      },
      "OAuthError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "error_description": { "type": "string" }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "code": { "type": "string" },
          "correlationId": { "type": "string" }
        }
      },
      "AuthorizationServerMetadata": {
        "type": "object",
        "required": ["issuer", "token_endpoint", "grant_types_supported"],
        "properties": {
          "issuer": { "type": "string" },
          "token_endpoint": { "type": "string" },
          "grant_types_supported": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "JWKS": {
        "type": "object",
        "required": ["keys"],
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kty", "crv", "x", "y"],
              "properties": {
                "kty": { "type": "string" },
                "crv": { "type": "string" },
                "x": { "type": "string" },
                "y": { "type": "string" },
                "kid": { "type": "string" },
                "alg": { "type": "string" },
                "use": { "type": "string" }
              }
            }
          }
        }
      },
      "NonceResponse": {
        "type": "object",
        "required": ["c_nonce"],
        "properties": {
          "c_nonce": { "type": "string" }
        }
      },
      "DeferredResponse": {
        "type": "object",
        "required": ["transaction_id", "interval"],
        "properties": {
          "transaction_id": { "type": "string" },
          "interval": { "type": "integer" }
        }
      },
      "DeferredPollRequest": {
        "type": "object",
        "required": ["transaction_id"],
        "properties": {
          "transaction_id": { "type": "string" }
        }
      },
      "IssuanceRequestInput": {
        "type": "object",
        "required": ["issuerId", "credentialDefinition", "claims"],
        "properties": {
          "issuerId": { "type": "string" },
          "credentialDefinition": { "type": "string" },
          "claims": { "type": "object" },
          "delivery": {
            "type": "object",
            "properties": {
              "flow": { "type": "string" },
              "expiresInSeconds": { "type": "integer" },
              "deferred": { "type": "boolean" }
            }
          }
        }
      },
      "IssuanceRequestResult": {
        "type": "object",
        "required": ["id", "offerState", "issuanceState", "issuerId", "credentialConfigurationId", "credentialOfferUri", "expiresAt", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "offerState": { "type": "string" },
          "issuanceState": { "type": "string" },
          "issuerId": { "type": "string" },
          "credentialConfigurationId": { "type": "string" },
          "credentialOfferUri": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "IssuanceRequestStatus": {
        "type": "object",
        "required": ["id", "offerState", "issuanceState", "issuerId", "credentialConfigurationId", "expiresAt", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "offerState": { "type": "string" },
          "issuanceState": { "type": "string" },
          "issuerId": { "type": "string" },
          "credentialConfigurationId": { "type": "string" },
          "credentialId": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "StatusChangeInput": {
        "type": "object",
        "properties": {
          "reasonCode": { "type": "string" },
          "comment": { "type": "string" }
        }
      },
      "StatusChangeResult": {
        "type": "object",
        "required": ["credentialId", "state", "desiredStatus", "publishedStatus", "statusListVersion", "propagationState", "effectiveAt"],
        "properties": {
          "credentialId": { "type": "string" },
          "state": { "type": "string" },
          "desiredStatus": { "type": "string" },
          "publishedStatus": { "type": "string" },
          "statusListVersion": { "type": "integer" },
          "propagationState": { "type": "string" },
          "effectiveAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateIssuerInput": {
        "type": "object",
        "required": ["slug", "displayName"],
        "properties": {
          "issuerId": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "displayName": { "type": "string" },
          "initialKid": { "type": "string" }
        }
      },
      "RotateKeyInput": {
        "type": "object",
        "required": ["kid"],
        "properties": {
          "kid": { "type": "string" }
        }
      },
      "DefinitionDraftInput": {
        "type": "object",
        "required": ["configurationId", "displayName", "types", "fields"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "configurationId": { "type": "string" },
          "displayName": { "type": "string" },
          "locale": { "type": "string" },
          "contexts": { "type": "array", "items": { "type": "string" } },
          "types": { "type": "array", "items": { "type": "string" } },
          "fields": { "type": "object" },
          "defaultValiditySeconds": { "type": "integer" },
          "statusPurposes": { "type": "array", "items": { "type": "string" } },
          "publishSchema": { "type": "boolean" }
        }
      },
      "RegisterClientInput": {
        "type": "object",
        "required": ["clientName", "allowedIssuers", "scopes"],
        "properties": {
          "clientId": { "type": "string", "format": "uuid" },
          "clientName": { "type": "string" },
          "allowedIssuers": { "type": "array", "items": { "type": "string", "format": "uuid" } },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
