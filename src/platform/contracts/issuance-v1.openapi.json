{
  "openapi": "3.0.3",
  "info": {
    "title": "HukID Issuance, Status & Admin Platform API",
    "version": "1.0.0",
    "description": "Full OpenAPI 3.0.3 contract covering OID4VCI 1.0 public/wallet endpoints, W3C Bitstring Status Lists & JSON Schema/JSON-LD verification resources, M2M Integration/Status APIs, and Tenant Operator Administrative APIs."
  },
  "servers": [
    {
      "url": "https://api.hukid.pe",
      "description": "HukID Production API"
    },
    {
      "url": "https://issuer.hukid.pe",
      "description": "HukID Issuer & Public Resources Host"
    }
  ],
  "security": [],
  "paths": {
    "/.well-known/oauth-authorization-server": {
      "get": {
        "operationId": "getAuthorizationServerMetadata",
        "summary": "OAuth 2.0 Authorization Server Metadata (RFC 8414)",
        "responses": {
          "200": {
            "description": "Authorization Server metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthorizationServerMetadata" }
              }
            }
          }
        }
      }
    },
    "/{slug}/.well-known/jwks.json": {
      "parameters": [
        { "$ref": "#/components/parameters/IssuerSlug" }
      ],
      "get": {
        "operationId": "getIssuerJWKS",
        "summary": "Issuer public P-256 JWKS (excludes compromised keys)",
        "responses": {
          "200": {
            "description": "JWKS document",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JWKS" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/OAuthError404" }
        }
      }
    },
    "/{slug}/.well-known/openid-credential-issuer": {
      "parameters": [
        { "$ref": "#/components/parameters/IssuerSlug" }
      ],
      "get": {
        "operationId": "getIssuerMetadata",
        "summary": "OID4VCI 1.0 Credential Issuer Metadata",
        "responses": {
          "200": {
            "description": "OID4VCI issuer metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/OAuthError404" }
        }
      }
    },
    "/{slug}/offers/{ref}": {
      "parameters": [
        { "$ref": "#/components/parameters/IssuerSlug" },
        { "$ref": "#/components/parameters/OfferRef" }
      ],
      "get": {
        "operationId": "getCredentialOffer",
        "summary": "Dereference single-use OID4VCI Credential Offer",
        "responses": {
          "200": {
            "description": "Credential Offer payload",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/OAuthError404" }
        }
      }
    },
    "/oauth2/token": {
      "post": {
        "operationId": "postOAuthToken",
        "summary": "OAuth2 Token Endpoint (pre-authorized_code & client_credentials)",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/GenericJSON" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Issued access token",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/OAuthError400" },
          "401": { "$ref": "#/components/responses/OAuthError401" }
        }
      }
    },
    "/{slug}/nonce": {
      "parameters": [
        { "$ref": "#/components/parameters/IssuerSlug" }
      ],
      "post": {
        "operationId": "postCredentialNonce",
        "summary": "Issue fresh single-use c_nonce",
        "responses": {
          "200": {
            "description": "Nonce issued",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NonceResponse" }
              }
            }
          }
        }
      }
    },
    "/{slug}/credential": {
      "parameters": [
        { "$ref": "#/components/parameters/IssuerSlug" }
      ],
      "post": {
        "operationId": "postCredential",
        "summary": "OID4VCI Credential Endpoint (immediate 200 or deferred 202)",
        "security": [{ "oid4vciBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenericJSON" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Issued vc+jwt credential",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "202": {
            "description": "Deferred issuance accepted",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeferredResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/OAuthError400" },
          "401": { "$ref": "#/components/responses/OAuthError401" }
        }
      }
    },
    "/{slug}/deferred_credential": {
      "parameters": [
        { "$ref": "#/components/parameters/IssuerSlug" }
      ],
      "post": {
        "operationId": "postDeferredCredential",
        "summary": "OID4VCI Deferred Credential Polling Endpoint",
        "security": [{ "oid4vciBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeferredPollRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed deferred vc+jwt credential",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/OAuthError400" },
          "401": { "$ref": "#/components/responses/OAuthError401" }
        }
      }
    },
    "/{slug}/status-lists/{purpose}/{listId}": {
      "parameters": [
        { "$ref": "#/components/parameters/IssuerSlug" },
        { "$ref": "#/components/parameters/StatusPurpose" },
        { "$ref": "#/components/parameters/ListID" }
      ],
      "get": {
        "operationId": "getBitstringStatusList",
        "summary": "Public signed BitstringStatusListCredential JWT",
        "responses": {
          "200": {
            "description": "Signed application/vc+jwt status list",
            "content": {
              "application/vc+jwt": {
                "schema": { "type": "string" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/OAuthError404" }
        }
      }
    },
    "/{slug}/schemas/{definitionId}/{version}": {
      "parameters": [
        { "$ref": "#/components/parameters/IssuerSlug" },
        { "$ref": "#/components/parameters/DefinitionID" },
        { "$ref": "#/components/parameters/DefinitionVersionArtifact" }
      ],
      "get": {
        "operationId": "getDefinitionJSONSchema",
        "summary": "Public immutable JSON Schema (Draft 2020-12) for a published definition version",
        "responses": {
          "200": {
            "description": "JSON Schema document",
            "content": {
              "application/schema+json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/OAuthError404" }
        }
      }
    },
    "/{slug}/contexts/{definitionId}/{version}": {
      "parameters": [
        { "$ref": "#/components/parameters/IssuerSlug" },
        { "$ref": "#/components/parameters/DefinitionID" },
        { "$ref": "#/components/parameters/DefinitionVersionArtifact" }
      ],
      "get": {
        "operationId": "getDefinitionJSONLDContext",
        "summary": "Public immutable versioned JSON-LD @context for a published definition version",
        "responses": {
          "200": {
            "description": "JSON-LD context document",
            "content": {
              "application/ld+json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/OAuthError404" }
        }
      }
    },
    "/v1/issuance-requests": {
      "post": {
        "operationId": "createIssuanceRequest",
        "summary": "Create idempotent issuance request & OID4VCI offer",
        "security": [{ "integrationBearer": [] }],
        "x-required-scopes": ["issuance:create"],
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IssuanceRequestInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Issuance request created",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IssuanceRequestResult" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "403": { "$ref": "#/components/responses/Problem403" },
          "409": { "$ref": "#/components/responses/Problem409" },
          "422": { "$ref": "#/components/responses/Problem422" },
          "503": { "$ref": "#/components/responses/Problem503" }
        }
      }
    },
    "/v1/issuance-requests/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/RequestID" }
      ],
      "get": {
        "operationId": "getIssuanceRequest",
        "summary": "Inspect issuance request status owned by caller integration client",
        "security": [{ "integrationBearer": [] }],
        "x-required-scopes": ["issuance:read"],
        "responses": {
          "200": {
            "description": "Issuance request state",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IssuanceRequestStatus" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      },
      "delete": {
        "operationId": "cancelIssuanceRequest",
        "summary": "Cancel a pending/ready/deferred issuance request owned by caller client",
        "security": [{ "integrationBearer": [] }],
        "x-required-scopes": ["issuance:create"],
        "responses": {
          "200": {
            "description": "Issuance request cancelled",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IssuanceRequestStatus" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" },
          "409": { "$ref": "#/components/responses/Problem409" }
        }
      }
    },
    "/v1/credentials/{id}/suspension": {
      "parameters": [
        { "$ref": "#/components/parameters/CredentialHandleID" }
      ],
      "post": {
        "operationId": "suspendCredential",
        "summary": "Suspend an active credential via BitstringStatusList",
        "security": [{ "integrationBearer": [] }],
        "x-required-scopes": ["status:write"],
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StatusChangeInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credential suspended",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusChangeResult" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" },
          "409": { "$ref": "#/components/responses/Problem409" },
          "503": { "$ref": "#/components/responses/Problem503" }
        }
      },
      "delete": {
        "operationId": "reactivateCredential",
        "summary": "Reactivate a suspended credential",
        "security": [{ "integrationBearer": [] }],
        "x-required-scopes": ["status:write"],
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": {
            "description": "Credential reactivated",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusChangeResult" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" },
          "409": { "$ref": "#/components/responses/Problem409" },
          "503": { "$ref": "#/components/responses/Problem503" }
        }
      }
    },
    "/v1/credentials/{id}/revocation": {
      "parameters": [
        { "$ref": "#/components/parameters/CredentialHandleID" }
      ],
      "post": {
        "operationId": "revokeCredential",
        "summary": "Permanently revoke an issued credential",
        "security": [{ "integrationBearer": [] }],
        "x-required-scopes": ["status:write"],
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StatusChangeInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credential revoked",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusChangeResult" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" },
          "409": { "$ref": "#/components/responses/Problem409" },
          "503": { "$ref": "#/components/responses/Problem503" }
        }
      }
    },
    "/v1/operator/tenants/{tenantId}/issuers": {
      "parameters": [
        { "$ref": "#/components/parameters/TenantID" }
      ],
      "get": {
        "operationId": "operatorListIssuers",
        "summary": "List tenant issuers (scoped for issuer_operator)",
        "security": [{ "operatorBearer": [] }],
        "x-required-capabilities": ["issuers:manage"],
        "x-step-up-required": false,
        "responses": {
          "200": {
            "description": "Issuers list",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "403": { "$ref": "#/components/responses/Problem403" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      },
      "post": {
        "operationId": "operatorCreateIssuer",
        "summary": "Create tenant issuer and optional initial KMS key",
        "security": [{ "operatorBearer": [] }],
        "x-required-capabilities": ["issuers:manage"],
        "x-step-up-required": true,
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateIssuerInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Issuer created",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "403": { "$ref": "#/components/responses/Problem403" },
          "404": { "$ref": "#/components/responses/Problem404" },
          "422": { "$ref": "#/components/responses/Problem422" },
          "503": { "$ref": "#/components/responses/Problem503" }
        }
      }
    },
    "/v1/operator/tenants/{tenantId}/issuers/{issuerId}/keys/rotate": {
      "parameters": [
        { "$ref": "#/components/parameters/TenantID" },
        { "$ref": "#/components/parameters/IssuerID" }
      ],
      "post": {
        "operationId": "operatorRotateIssuerKey",
        "summary": "Provision and activate rotated ES256 KMS signing key",
        "security": [{ "operatorBearer": [] }],
        "x-required-capabilities": ["issuers:manage"],
        "x-step-up-required": true,
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RotateKeyInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Key rotated",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "403": { "$ref": "#/components/responses/Problem403" },
          "404": { "$ref": "#/components/responses/Problem404" },
          "409": { "$ref": "#/components/responses/Problem409" },
          "503": { "$ref": "#/components/responses/Problem503" }
        }
      }
    },
    "/v1/operator/tenants/{tenantId}/issuers/{issuerId}/keys/{kid}/compromise": {
      "parameters": [
        { "$ref": "#/components/parameters/TenantID" },
        { "$ref": "#/components/parameters/IssuerID" },
        { "$ref": "#/components/parameters/KeyID" }
      ],
      "post": {
        "operationId": "operatorCompromiseIssuerKey",
        "summary": "Mark issuer signing key compromised, drop from JWKS and report impacted vc ids",
        "security": [{ "operatorBearer": [] }],
        "x-required-capabilities": ["issuers:manage"],
        "x-step-up-required": true,
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": {
            "description": "Key compromised report",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "403": { "$ref": "#/components/responses/Problem403" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      }
    },
    "/v1/operator/tenants/{tenantId}/issuers/{issuerId}/credential-definitions": {
      "parameters": [
        { "$ref": "#/components/parameters/TenantID" },
        { "$ref": "#/components/parameters/IssuerID" }
      ],
      "get": {
        "operationId": "operatorListDefinitions",
        "summary": "List credential definition versions for an issuer",
        "security": [{ "operatorBearer": [] }],
        "x-required-capabilities": ["definitions:manage"],
        "x-step-up-required": false,
        "responses": {
          "200": {
            "description": "Definitions list",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "403": { "$ref": "#/components/responses/Problem403" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      },
      "post": {
        "operationId": "operatorCreateDraftDefinition",
        "summary": "Create draft credential definition version",
        "security": [{ "operatorBearer": [] }],
        "x-required-capabilities": ["definitions:manage"],
        "x-step-up-required": true,
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DefinitionDraftInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" },
              "ETag": { "$ref": "#/components/headers/ETag" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "403": { "$ref": "#/components/responses/Problem403" },
          "404": { "$ref": "#/components/responses/Problem404" },
          "409": { "$ref": "#/components/responses/Problem409" },
          "422": { "$ref": "#/components/responses/Problem422" }
        }
      }
    },
    "/v1/operator/tenants/{tenantId}/issuers/{issuerId}/credential-definitions/{definitionId}/versions/{version}": {
      "parameters": [
        { "$ref": "#/components/parameters/TenantID" },
        { "$ref": "#/components/parameters/IssuerID" },
        { "$ref": "#/components/parameters/DefinitionID" },
        { "$ref": "#/components/parameters/DefinitionVersion" }
      ],
      "get": {
        "operationId": "operatorGetDefinitionVersion",
        "summary": "Get one credential definition version",
        "security": [{ "operatorBearer": [] }],
        "x-required-capabilities": ["definitions:manage"],
        "x-step-up-required": false,
        "responses": {
          "200": {
            "description": "Definition version",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" },
              "ETag": { "$ref": "#/components/headers/ETag" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericJSON" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "403": { "$ref": "#/components/responses/Problem403" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      },
      "put": {
        "operationId": "operatorReplaceDraftDefinition",
        "summary": "Replace draft credential definition version with If-Match ETag check",
        "security": [{ "operatorBearer": [] }],
        "x-required-capabilities": ["definitions:manage"],
        "x-step-up-required": true,
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DefinitionDraftInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft replaced",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" },
              "ETag": { "$ref": "#/components/headers/ETag" }
            },
            "content": {
              "application/json": {
