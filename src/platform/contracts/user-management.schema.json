{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hukid.example.invalid/schemas/user-management-v0.1",
  "title": "Member management transport schemas — laboratory baseline",
  "$ref": "#/$defs/Membership",
  "$defs": {
    "Role": {
      "type": "string",
      "enum": [
        "issuer_operator",
        "security_admin",
        "support_readonly",
        "tenant_admin"
      ]
    },
    "Email": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$",
      "allOf": [
        {
          "pattern": "^[^@]{1,64}@"
        }
      ],
      "description": "ASCII dot-atom, local part <=64 bytes. Domain is lowercased; local part is case-sensitive. No trimming, alias folding, quoted names, IP literals or Unicode."
    },
    "MembershipState": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "revoked"
      ]
    },
    "InvitationState": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revoked",
        "expired"
      ]
    },
    "Membership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "membershipId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operatorIdentityId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "issuer_operator",
              "security_admin",
              "support_readonly",
              "tenant_admin"
            ]
          }
        },
        "issuerIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "suspended",
            "revoked"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lifecycle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tenantId",
        "membershipId",
        "operatorIdentityId",
        "roles",
        "issuerIds",
        "state",
        "revision",
        "lifecycle",
        "createdAt",
        "updatedAt"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "roles": {
                "type": "array",
                "contains": {
                  "const": "issuer_operator"
                }
              }
            },
            "required": [
              "roles"
            ]
          },
          "then": {
            "properties": {
              "issuerIds": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "issuerIds": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "Invitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "invitationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "recipientHint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "issuer_operator",
              "security_admin",
              "support_readonly",
              "tenant_admin"
            ]
          }
        },
        "issuerIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "revoked",
            "expired"
          ]
        },
        "deliveryState": {
          "type": "string",
          "enum": [
            "queued",
            "sent",
            "failed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "acceptedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revokedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "tenantId",
        "invitationId",
        "recipientHint",
        "roles",
        "issuerIds",
        "state",
        "deliveryState",
        "revision",
        "createdAt",
        "expiresAt",
        "acceptedAt",
        "revokedAt"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "roles": {
                "type": "array",
                "contains": {
                  "const": "issuer_operator"
                }
              }
            },
            "required": [
              "roles"
            ]
          },
          "then": {
            "properties": {
              "issuerIds": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "issuerIds": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "acceptedAt": {
                "type": "string",
                "format": "date-time"
              },
              "revokedAt": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "acceptedAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "revoked"
              }
            }
          },
          "then": {
            "properties": {
              "revokedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "else": {
            "properties": {
              "revokedAt": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "InviteMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "$ref": "#/$defs/Email"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "issuer_operator",
              "security_admin",
              "support_readonly",
              "tenant_admin"
            ]
          }
        },
        "issuerIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      },
      "required": [
        "email",
        "roles",
        "issuerIds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "roles": {
                "type": "array",
                "contains": {
                  "const": "issuer_operator"
                }
              }
            },
            "required": [
              "roles"
            ]
          },
          "then": {
            "properties": {
              "issuerIds": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "issuerIds": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "AcceptInvitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "description": "32 random bytes as canonical unpadded base64url. Synthetic examples only; never log the body."
        }
      },
      "required": [
        "token"
      ]
    },
    "RevokeInvitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reasonCode": {
          "type": "string",
          "enum": [
            "access_change",
            "security_response",
            "operator_request",
            "invitation_cancelled"
          ]
        }
      },
      "required": [
        "reasonCode"
      ]
    },
    "ChangeMembership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "issuer_operator",
              "security_admin",
              "support_readonly",
              "tenant_admin"
            ]
          }
        },
        "issuerIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "suspended",
            "revoked"
          ]
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "access_change",
            "security_response",
            "operator_request",
            "invitation_cancelled"
          ]
        }
      },
      "required": [
        "reasonCode"
      ],
      "anyOf": [
        {
          "required": [
            "roles"
          ]
        },
        {
          "required": [
            "issuerIds"
          ]
        },
        {
          "required": [
            "state"
          ]
        }
      ],
      "dependentRequired": {
        "roles": [
          "issuerIds"
        ],
        "issuerIds": [
          "roles"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "roles"
            ]
          },
          "then": {
            "if": {
              "properties": {
                "roles": {
                  "type": "array",
                  "contains": {
                    "const": "issuer_operator"
                  }
                }
              },
              "required": [
                "roles"
              ]
            },
            "then": {
              "properties": {
                "issuerIds": {
                  "type": "array",
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "issuerIds": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          }
        }
      ]
    },
    "Acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "membership": {
          "$ref": "#/$defs/Membership"
        }
      },
      "required": [
        "tenantId",
        "membership"
      ]
    },
    "MembershipPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Membership"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 32,
              "maxLength": 2048,
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "Authenticated opaque cursor bound to actor, tenant, operation and normalized filters/limit. Server checks signature, version and expiry."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "InvitationPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Invitation"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 32,
              "maxLength": 2048,
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "Authenticated opaque cursor bound to actor, tenant, operation and normalized filters/limit. Server checks signature, version and expiry."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "about:blank"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "integer",
          "enum": [
            400,
            401,
            403,
            404,
            409,
            412,
            415,
            422,
            428,
            429,
            503
          ]
        },
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "invalid_cursor",
            "invalid_credential",
            "forbidden",
            "mfa_required",
            "csrf_invalid",
            "origin_invalid",
            "recipient_unverified",
            "resource_not_found",
            "membership_exists",
            "membership_revoked",
            "invitation_not_pending",
            "invitation_invalid",
            "last_admin_required",
            "idempotency_conflict",
            "operation_in_progress",
            "revision_mismatch",
            "unsupported_media_type",
            "invalid_input",
            "precondition_required",
            "rate_limited",
            "dependency_unavailable"
          ]
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "correlationId"
      ],
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": 400
            },
            "code": {
              "enum": [
                "invalid_request",
                "invalid_cursor"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 401
            },
            "code": {
              "enum": [
                "invalid_credential"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 403
            },
            "code": {
              "enum": [
                "forbidden",
                "mfa_required",
                "csrf_invalid",
                "origin_invalid",
                "recipient_unverified"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 404
            },
            "code": {
              "enum": [
                "resource_not_found"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 409
            },
            "code": {
              "enum": [
                "membership_exists",
                "membership_revoked",
                "invitation_not_pending",
                "invitation_invalid",
                "last_admin_required",
                "idempotency_conflict",
                "operation_in_progress"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 412
            },
            "code": {
              "enum": [
                "revision_mismatch"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 415
            },
            "code": {
              "enum": [
                "unsupported_media_type"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 422
            },
            "code": {
              "enum": [
                "invalid_input"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 428
            },
            "code": {
              "enum": [
                "precondition_required"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 429
            },
            "code": {
              "enum": [
                "rate_limited"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 503
            },
            "code": {
              "enum": [
                "dependency_unavailable"
              ]
            }
          }
        }
      ]
    }
  }
}
